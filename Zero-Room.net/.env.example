# Relay configuration (all optional)
PORT=8888
# Keep the relay on loopback; only the reverse proxy should reach it.
HOST=127.0.0.1
# Extra browser origins allowed to open WebSockets (same-host pages are always allowed).
# ALLOWED_ORIGINS=https://chat.example.com
# MAX_CONN_PER_IP=30
# MAX_CONNECTIONS=4000
# MAX_ROOMS=2000
# MAX_ROOMS_PER_IP=10
# MAX_PEERS_PER_ROOM=20
# Proof-of-work difficulty for creating a room: 0 = off, default 14 (about half a second), max 22.
# POW_BASE_BITS=14
